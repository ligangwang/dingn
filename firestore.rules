service cloud.firestore {
  match /databases/{database}/documents {
    // Billing and ownership are server-only. Legacy Stripe extension records
    // remain excluded so old billing data cannot become writable.
    match /{collection}/{document=**} {
      allow read, write: if request.auth != null
        && !(collection in ['feedback', 'players', 'plays', 'customers', 'products', 'shopOrders', 'shopInventory', 'games', 'developers', 'gameReports', 'gameStats', 'mail']);
    }
    // The game registry is written only by the game publisher (Admin SDK) and
    // read by the dingn server, which serves it at /api/games.
    match /games/{document=**} {
      allow read, write: if false;
    }
    // The game platform's server-only records: developer agreements, player
    // reports, play counts and queued emails (scripts/platform-store.mjs).
    match /developers/{document=**} {
      allow read, write: if false;
    }
    match /gameReports/{document=**} {
      allow read, write: if false;
    }
    match /gameStats/{document=**} {
      allow read, write: if false;
    }
    match /mail/{document=**} {
      allow read, write: if false;
    }
    match /shopOrders/{document=**} {
      allow read, write: if false;
    }
    match /shopInventory/{document=**} {
      allow read, write: if false;
    }
    // XP, levels and plays are written only by the dingn server (Admin SDK),
    // which scores every game itself. Browsers cannot read or write them.
    match /players/{id} {
      allow read, write: if false;
    }
    match /plays/{id} {
      allow read, write: if false;
    }
    match /feedback/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['uid', 'message', 'createdAt', 'status'])
        && request.resource.data.keys().hasOnly(['uid', 'message', 'createdAt', 'status'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && request.resource.data.message.matches('(?s).*[^\\s].*')
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'new';
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow update, delete: if false;
    }
  }
}
