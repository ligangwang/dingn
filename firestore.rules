service cloud.firestore {
  match /databases/{database}/documents {
    // The administrator role (scripts/roles.mjs), from the account's ID
    // token. Accounts not yet moved to `roles` (scripts/migrate-roles.mjs)
    // still carry `admin: true`.
    function isAdmin() {
      return request.auth != null
        && ((request.auth.token.get('roles', []) is list
              && 'administrator' in request.auth.token.get('roles', []))
          || request.auth.token.get('admin', false) == true);
    }

    // Nothing is open unless a rule below opens it: a collection with no rule
    // (billing records, the old Stripe extension's customers and products, or
    // anything new) is server-only. The dingn server uses the Admin SDK, which
    // these rules do not limit; browsers reach the database only through
    // /api/data (scripts/api.mjs) with their own token, or with the token a
    // Google sign-in leaves in the browser.

    // A player's account: name, avatar and saved game progress. Any signed-in
    // player may read one player's account, as another player's page shows it;
    // only its owner may write it, and never its nickname or public number:
    // both are unique, so only the server sets them, after checking they are
    // free (claimNickname, ensureNickname and ensurePlayerNumber in
    // scripts/game-api.mjs). Listing every account is for admins only.
    match /accounts/{uid} {
      allow get: if request.auth != null;
      allow list: if isAdmin();
      allow create: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['user_name', 'name_key', 'player_no']);
      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['user_name', 'name_key', 'player_no']);
      allow delete: if false;
    }
    // A player's favourite word for each number (src/lib/repository.ts),
    // kept as "<uid>-<number>" with the owner's uid in it: theirs alone.
    match /number_favorites/{id} {
      allow read: if request.auth != null
        && (resource == null || resource.data.uid == request.auth.uid);
      allow create, update: if request.auth != null
        && (resource == null || resource.data.uid == request.auth.uid)
        && request.resource.data.uid == request.auth.uid
        && id == request.auth.uid + '-' + request.resource.data.number;
      allow delete: if false;
    }
    // The Major System dictionary: read by every signed-in player, written
    // only by dingn's own scripts.
    match /numbers/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /words/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // The game registry is written only by the game publisher (Admin SDK) and
    // read by the dingn server, which serves it at /api/games.
    match /games/{document=**} {
      allow read, write: if false;
    }
    // The game platform's server-only records: developer agreements, player
    // reports, play counts and queued emails (scripts/platform-store.mjs).
    match /developers/{document=**} {
      allow read, write: if false;
    }
    match /gameReports/{document=**} {
      allow read, write: if false;
    }
    match /gameStats/{document=**} {
      allow read, write: if false;
    }
    // Funnel counts by day (scripts/funnel.mjs): server-only.
    match /funnelStats/{document=**} {
      allow read, write: if false;
    }
    match /mail/{document=**} {
      allow read, write: if false;
    }
    // Coins and badges (scripts/rewards.mjs): only the dingn server changes
    // them, so a player can never give themselves coins.
    match /rewards/{document=**} {
      allow read, write: if false;
    }
    // Saved challenge links (scripts/challenges.mjs): server-only, so nobody
    // can change the score a link shows.
    match /challenges/{document=**} {
      allow read, write: if false;
    }
    // The open challenges of each game (scripts/challenges.mjs): server-only.
    match /challengeBoards/{document=**} {
      allow read, write: if false;
    }
    // Which challenge is open for each level (scripts/challenges.mjs): server-only.
    match /challengeRounds/{document=**} {
      allow read, write: if false;
    }
    // Each player's best under a challenge (scripts/challenges.mjs): server-only.
    match /challengeResults/{document=**} {
      allow read, write: if false;
    }
    // Friends brought through challenge links (scripts/referrals.mjs):
    // server-only, so nobody can pay themselves for a friend.
    match /referrals/{document=**} {
      allow read, write: if false;
    }
    match /shopOrders/{document=**} {
      allow read, write: if false;
    }
    match /shopInventory/{document=**} {
      allow read, write: if false;
    }
    // Coin pack orders (scripts/billing.mjs): server-only, like shopOrders.
    match /coinOrders/{document=**} {
      allow read, write: if false;
    }
    // XP, levels and plays are written only by the dingn server (Admin SDK),
    // which scores every game itself. Browsers cannot read or write them.
    match /players/{id} {
      allow read, write: if false;
    }
    match /plays/{id} {
      allow read, write: if false;
    }
    match /feedback/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['uid', 'message', 'createdAt', 'status'])
        && request.resource.data.keys().hasOnly(['uid', 'message', 'createdAt', 'status'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && request.resource.data.message.matches('(?s).*[^\\s].*')
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'new';
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
