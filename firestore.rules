service cloud.firestore {
  match /databases/{database}/documents {
    // Preserve existing collection access, excluding private feedback and
    // server-owned game data.
    match /{collection}/{document=**} {
      allow read, write: if request.auth != null
        && !(collection in ['feedback', 'players', 'plays']);
    }
    // XP, levels and plays are written only by the dingn server (Admin SDK),
    // which scores every game itself. Browsers cannot read or write them.
    match /players/{id} {
      allow read, write: if false;
    }
    match /plays/{id} {
      allow read, write: if false;
    }
    match /feedback/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['uid', 'message', 'createdAt', 'status'])
        && request.resource.data.keys().hasOnly(['uid', 'message', 'createdAt', 'status'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && request.resource.data.message.matches('(?s).*[^\\s].*')
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'new';
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow update, delete: if false;
    }
  }
}
